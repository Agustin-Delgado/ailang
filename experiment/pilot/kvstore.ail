(struct Undo (key Str) (had Bool) (old Str))

(fn record (params (txs (mut (Vec (Vec Undo)))) (db (Map Str Str)) (key Str))
  (body
    (if (not (is-empty txs))
      (do
        (let n (- (len txs) 1))
        (let u (match (get db key)
                 (case (some v) (new Undo (key key) (had true) (old v)))
                 (case none (new Undo (key key) (had false) (old "")))))
        (push (mut (at txs n)) u)))))

(fn main (params (con Console))
  (body
    (var db (Map Str Str) (map))
    (var txs (Vec (Vec Undo)) (vec))
    (var line (read-line con))
    (while (is-some line)
      (let parts (split (trim (unwrap-or line "")) " "))
      (let cmd (at parts 0))
      (if (== cmd "SET")
        (do
          (record (mut txs) db (at parts 1))
          (put (mut db) (at parts 1) (at parts 2))))
      (if (== cmd "GET")
        (println con (unwrap-or (get db (at parts 1)) "NULL")))
      (if (== cmd "DELETE")
        (do
          (record (mut txs) db (at parts 1))
          (del (mut db) (at parts 1))))
      (if (== cmd "COUNT")
        (do
          (var c 0)
          (for v (values db) (if (== v (at parts 1)) (set c (+ c 1))))
          (println con c)))
      (if (== cmd "BEGIN")
        (push (mut txs) (vec)))
      (if (== cmd "ROLLBACK")
        (match (pop (mut txs))
          (case none (println con "NO TRANSACTION"))
          (case (some log)
            (do
              (var i (- (len log) 1))
              (while (>= i 0)
                (let u (at log i))
                (if (. u had)
                  (put (mut db) (. u key) (. u old))
                  (do (del (mut db) (. u key)) unit))
                (set i (- i 1)))))))
      (if (== cmd "COMMIT")
        (if (is-empty txs)
          (println con "NO TRANSACTION")
          (clear (mut txs))))
      (set line (read-line con)))))
