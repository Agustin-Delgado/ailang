(fn main (params (con Console))
  (body
    (var bal (Map Str I64) (map))
    (var line (read-line con))
    (while (is-some line)
      (let parts (split (trim (unwrap-or line "")) " "))
      (let cmd (at parts 0))
      (if (== cmd "open")
        (if (has bal (at parts 1))
          (println con "error: " (at parts 1) " exists")
          (put (mut bal) (at parts 1) 0)))
      (if (== cmd "deposit")
        (if (has bal (at parts 1))
          (put (mut bal) (at parts 1) (+ (unwrap-or (get bal (at parts 1)) 0) (unwrap-or (parse-i64 (at parts 2)) 0)))
          (println con "error: no account " (at parts 1))))
      (if (== cmd "withdraw")
        (if (has bal (at parts 1))
          (do
            (let amt (unwrap-or (parse-i64 (at parts 2)) 0))
            (let cur (unwrap-or (get bal (at parts 1)) 0))
            (if (< cur amt)
              (println con "error: insufficient funds in " (at parts 1))
              (put (mut bal) (at parts 1) (- cur amt))))
          (println con "error: no account " (at parts 1))))
      (if (== cmd "transfer")
        (if (not (has bal (at parts 1)))
          (println con "error: no account " (at parts 1))
          (if (not (has bal (at parts 2)))
            (println con "error: no account " (at parts 2))
            (do
              (let amt (unwrap-or (parse-i64 (at parts 3)) 0))
              (let cur (unwrap-or (get bal (at parts 1)) 0))
              (if (< cur amt)
                (println con "error: insufficient funds in " (at parts 1))
                (do
                  (put (mut bal) (at parts 1) (- cur amt))
                  (put (mut bal) (at parts 2) (+ (unwrap-or (get bal (at parts 2)) 0) amt))))))))
      (set line (read-line con)))
    (for k (keys bal)
      (println con k " " (unwrap-or (get bal k) 0)))))
