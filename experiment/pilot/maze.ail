(fn main (params (con Console))
  (body
    (var g (Vec (Vec Str)) (vec))
    (var line (read-line con))
    (while (is-some line)
      (let s (trim (unwrap-or line "")))
      (if (!= s "") (push (mut g) (chars s)))
      (set line (read-line con)))
    (let h (len g))
    (let w (len (at g 0)))
    (var dist (Vec I64) (fill (* h w) -1))
    (var q (Vec I64) (vec))
    (var target -1)
    (for r (range 0 h)
      (for c (range 0 w)
        (if (== (at (at g r) c) "S")
          (do (set (at dist (+ (* r w) c)) 0) (push (mut q) (+ (* r w) c))))
        (if (== (at (at g r) c) "E") (set target (+ (* r w) c)))))
    (var head 0)
    (var drs (Vec I64) (vec -1 1 0 0))
    (var dcs (Vec I64) (vec 0 0 -1 1))
    (while (< head (len q))
      (let cur (at q head))
      (set head (+ head 1))
      (let r (/ cur w))
      (let c (% cur w))
      (for k (range 0 4)
        (let nr (+ r (at drs k)))
        (let nc (+ c (at dcs k)))
        (if (and (>= nr 0) (< nr h) (>= nc 0) (< nc w))
          (if (and (!= (at (at g nr) nc) "#") (== (at dist (+ (* nr w) nc)) -1))
            (do
              (set (at dist (+ (* nr w) nc)) (+ (at dist cur) 1))
              (push (mut q) (+ (* nr w) nc)))))))
    (println con (at dist target))
    (println con (len q))))
