(fn main (params (con Console))
  (body
    (var line (read-line con))
    (while (is-some line)
      (let cs (chars (unwrap-or line "")))
      (var stack (Vec Str) (vec))
      (var bad 0)
      (for i (range 0 (len cs))
        (let c (at cs i))
        (if (or (== c "(") (== c "[") (== c "{"))
          (push (mut stack) c)
          (if (or (== c ")") (== c "]") (== c "}"))
            (do
              (let want (if (== c ")") "(" (if (== c "]") "[" "{")))
              (match (pop (mut stack))
                (case (some top) (if (!= top want) (do (set bad (+ i 1)) break)))
                (case none (do (set bad (+ i 1)) break)))))))
      (if (> bad 0)
        (println con "error at " bad)
        (if (is-empty stack)
          (println con "ok")
          (println con "error at " (+ (len cs) 1))))
      (set line (read-line con)))))
