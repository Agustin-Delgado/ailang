(struct Item (qty I64) (price I64))
(struct Row (neg I64) (name Str))

(fn main (params (con Console))
  (body
    (var items (Map Str Item) (map))
    (var spent (Map Str I64) (map))
    (var revenue 0)
    (var line (read-line con))
    (while (is-some line)
      (let parts (split (trim (unwrap-or line "")) " "))
      (let cmd (at parts 0))
      (if (== cmd "stock")
        (do
          (let name (at parts 1))
          (let q (unwrap-or (parse-i64 (at parts 2)) 0))
          (let pr (unwrap-or (parse-i64 (at parts 3)) 0))
          (match (get items name)
            (case (some it) (put (mut items) name (new Item (qty (+ (. it qty) q)) (price pr))))
            (case none (put (mut items) name (new Item (qty q) (price pr)))))))
      (if (== cmd "order")
        (do
          (let cust (at parts 1))
          (let name (at parts 2))
          (let q (unwrap-or (parse-i64 (at parts 3)) 0))
          (match (get items name)
            (case none (println con "error: unknown item " name))
            (case (some it)
              (if (< (. it qty) q)
                (println con "error: only " (. it qty) " " name " left")
                (do
                  (let cost (* q (. it price)))
                  (put (mut items) name (with it (qty (- (. it qty) q))))
                  (put (mut spent) cust (+ (unwrap-or (get spent cust) 0) cost))
                  (set revenue (+ revenue cost))))))))
      (set line (read-line con)))
    (for k (keys items)
      (println con k " " (. (expect (get items k) "item") qty)))
    (var rows (Vec Row) (vec))
    (for k (keys spent)
      (push (mut rows) (new Row (neg (- (unwrap-or (get spent k) 0))) (name k))))
    (sort (mut rows))
    (for r rows
      (println con (. r name) " " (- (. r neg))))
    (println con "revenue " revenue)))
