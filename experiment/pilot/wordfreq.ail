(struct Row (neg I64) (word Str))

(fn is-letter (params (b I64)) (returns Bool)
  (body (or (and (>= b 65) (<= b 90)) (and (>= b 97) (<= b 122)))))

(fn main (params (con Console))
  (body
    (var counts (Map Str I64) (map))
    (var line (read-line con))
    (while (is-some line)
      (let s (lower (unwrap-or line "")))
      (var cur "")
      (for i (range 0 (len s))
        (let b (byte-at s i))
        (if (is-letter b)
          (set cur (str cur (from-code b)))
          (do
            (if (!= cur "")
              (do (put (mut counts) cur (+ (unwrap-or (get counts cur) 0) 1)) (set cur "")))
            unit)))
      (if (!= cur "")
        (put (mut counts) cur (+ (unwrap-or (get counts cur) 0) 1)))
      (set line (read-line con)))
    (var rows (Vec Row) (vec))
    (for w (keys counts)
      (push (mut rows) (new Row (neg (- (unwrap-or (get counts w) 0))) (word w))))
    (sort (mut rows))
    (for i (range 0 (min 5 (len rows)))
      (println con (. (at rows i) word) " " (- (. (at rows i) neg))))))
