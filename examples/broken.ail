(enum Color (Red) (Green) (Blue))

(fn describe (params (c Color)) (returns Str)
  (body
    (match c
      (case Color.Red "red")
      (case Color.Green "green"))))

(fn log-sum (params (xs (Vec I64))) (returns I64)
  (body
    (let total 0)
    (for x xs (set total (+ total x)))
    (println "sum is " total)
    total))

(fn fill (params (v (Vec I64)))
  (body (push v 1)))

(fn main (params (con Console))
  (body
    (var data (vec 1 2 3))
    (fill data)
    (println con (describe Color.Blue) (log-sum data))))
