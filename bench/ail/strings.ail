(fn main (params (con Console))
  (body
    (var words (Vec Str) (vec))
    (for i (range 0 200000) (push (mut words) (str "w" (% (* i 31) 5003))))
    (let text (join words " "))
    (var counts (Map Str I64) (map))
    (for _r (range 0 20)
      (for w (split text " ")
        (put (mut counts) w (+ 1 (unwrap-or (get counts w) 0)))))
    (var best "")
    (var best-n 0)
    (for k (keys counts)
      (let c (unwrap-or (get counts k) 0))
      (if (> c best-n)
        (do (set best k) (set best-n c))))
    (println con (len counts) " " best " " best-n " " (len text))))
