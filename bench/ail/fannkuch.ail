(fn fannkuch (params (n I64)) (returns I64)
  (body
    (var perm (fill n 0))
    (var perm1 (fill n 0))
    (var count (fill n 0))
    (for i (range 0 n) (set (at perm1 i) i))
    (var max-flips 0)
    (var checksum 0)
    (var perm-count 0)
    (var r n)
    (var done false)
    (while (not done)
      (while (!= r 1)
        (set (at count (- r 1)) r)
        (set r (- r 1)))
      (for i (range 0 n) (set (at perm i) (at perm1 i)))
      (var flips 0)
      (var k (at perm 0))
      (while (!= k 0)
        (var i 0)
        (var j k)
        (while (< i j)
          (swap (mut perm) i j)
          (set i (+ i 1))
          (set j (- j 1)))
        (set flips (+ flips 1))
        (set k (at perm 0)))
      (set max-flips (max max-flips flips))
      (set checksum (if (== (% perm-count 2) 0) (+ checksum flips) (- checksum flips)))
      (var more true)
      (while more
        (if (== r n)
          (do (set done true) (set more false))
          (do
            (let p0 (at perm1 0))
            (for i (range 0 r) (set (at perm1 i) (at perm1 (+ i 1))))
            (set (at perm1 r) p0)
            (set (at count r) (- (at count r) 1))
            (if (> (at count r) 0)
              (set more false)
              (set r (+ r 1))))))
      (set perm-count (+ perm-count 1)))
    (+ (* checksum 1000) max-flips)))

(fn main (params (con Console))
  (body (println con (fannkuch 11))))
