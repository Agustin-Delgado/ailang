; game: headless arena simulation (entity update + spatial grid collisions)

(struct Entity (x F64) (y F64) (vx F64) (vy F64) (r F64) (hp I64))

(const W F64 1600.0)
(const H F64 1200.0)
(const N I64 4000)
(const FRAMES I64 1500)
(const CELL F64 32.0)
(const SEED I64 12345)

(fn next-rand (params (state (mut I64))) (returns I64)
  (body
    (set state (% (* state 48271) 2147483647))
    state))

(fn next-unit (params (state (mut I64))) (returns F64)
  (body (/ (as F64 (next-rand (mut state))) 2147483647.0)))

(fn spawn (params (state (mut I64))) (returns Entity)
  (body
    (let r (+ 3.0 (* (next-unit (mut state)) 9.0)))
    (let x (+ r (* (next-unit (mut state)) (- W (* 2.0 r)))))
    (let y (+ r (* (next-unit (mut state)) (- H (* 2.0 r)))))
    (let angle (* (next-unit (mut state)) 6.283185307179586))
    (let speed (+ 40.0 (* (next-unit (mut state)) 160.0)))
    (new Entity (x x) (y y) (vx (* (cos angle) speed)) (vy (* (sin angle) speed)) (r r) (hp 3))))

(fn move-all (params (es (mut (Vec Entity))) (dt F64))
  (body
    (for i (range 0 (len es))
      (var e (at es i))
      (set (. e x) (+ (. e x) (* (. e vx) dt)))
      (set (. e y) (+ (. e y) (* (. e vy) dt)))
      (if (< (. e x) (. e r))
        (do (set (. e x) (. e r)) (set (. e vx) (- (. e vx))))
        (if (> (. e x) (- W (. e r)))
          (do (set (. e x) (- W (. e r))) (set (. e vx) (- (. e vx))))))
      (if (< (. e y) (. e r))
        (do (set (. e y) (. e r)) (set (. e vy) (- (. e vy))))
        (if (> (. e y) (- H (. e r)))
          (do (set (. e y) (- H (. e r))) (set (. e vy) (- (. e vy))))))
      (set (at es i) e))))

(fn cell-of (params (v F64) (limit I64)) (returns I64)
  (body (min (as I64 (floor (/ v CELL))) (- limit 1))))

(fn main (params (con Console))
  (body
    (let dt (/ 1.0 60.0))
    (let cols (as I64 (floor (/ W CELL))))
    (let rows (as I64 (floor (/ H CELL))))
    (var state SEED)
    (var es (Vec Entity) (vec))
    (for _i (range 0 N) (push (mut es) (spawn (mut state))))
    (var grid (Vec (Vec I64)) (fill (* cols rows) (vec)))
    (var cxs (fill N 0))
    (var cys (fill N 0))
    (var collisions 0)
    (var respawns 0)
    (for _f (range 0 FRAMES)
      (move-all (mut es) dt)
      (for c (range 0 (* cols rows)) (clear (mut (at grid c))))
      (for i (range 0 N)
        (let cx (cell-of (. (at es i) x) cols))
        (let cy (cell-of (. (at es i) y) rows))
        (set (at cxs i) cx)
        (set (at cys i) cy)
        (push (mut (at grid (+ (* cy cols) cx))) i))
      (for i (range 0 N)
        (let a (at es i))
        (let cx (at cxs i))
        (let cy (at cys i))
        (for ny (range (max 0 (- cy 1)) (min rows (+ cy 2)))
          (for nx (range (max 0 (- cx 1)) (min cols (+ cx 2)))
            (for j (at grid (+ (* ny cols) nx))
              (if (> j i)
                (do
                  (let b (at es j))
                  (let ddx (- (. b x) (. a x)))
                  (let ddy (- (. b y) (. a y)))
                  (let rr (+ (. a r) (. b r)))
                  (if (< (+ (* ddx ddx) (* ddy ddy)) (* rr rr))
                    (do
                      (set collisions (+ collisions 1))
                      (set (. (at es i) hp) (- (. (at es i) hp) 1))
                      (set (. (at es j) hp) (- (. (at es j) hp) 1))))))))))
      (for i (range 0 N)
        (if (<= (. (at es i) hp) 0)
          (do
            (set (at es i) (spawn (mut state)))
            (set respawns (+ respawns 1))))))
    (var checksum 0)
    (for e es
      (set checksum (+ checksum (as I64 (floor (. e x))) (as I64 (floor (. e y))))))
    (println con "collisions " collisions)
    (println con "respawns " respawns)
    (println con "checksum " checksum)))
