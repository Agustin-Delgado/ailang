; Tests for how strings are emitted: borrowed views, view-returning functions, map updates that
; look the key up once, and appending in place. Every case must behave exactly like a copy.
; Run with: ail test tests/strings.ail

(struct Named (name Str) (n I64))

(fn bang (params (s (mut Str))) (body (set s (str s "!"))))

(fn first-word (params (t Str)) (returns Str)
  (body
    (match (index-of t " ")
      (case (some i) (substr t 0 i))
      (case none t))))

(fn early (params (t Str)) (returns Str)
  (body
    (if (is-empty t) (return "empty"))
    (trim t)))

(fn norm (params (t Str)) (returns Str) (body (lower (trim t))))

(fn pick (params (a Str) (b Str) (first Bool)) (returns Str) (body (if first a b)))

(fn less (params (a Str) (b Str)) (returns Bool) (body (< a b)))

(fn kind (params (t Str)) (returns I64) (body (match t (case "a" 1) (case "bb" 2) (case _ 3))))

(fn same (params (t Str)) (returns Str) (ensures (== result t)) (body t))

(fn wrap (params (t Str)) (returns Named) (body (new Named (name t) (n (len t)))))

(fn checked-head (params (t Str) (ok Bool)) (returns Str)
  (body (if ok (substr t 0 1) (fail "not ok"))))

(test "a view does not see later changes to its source"
  (var s "hello world")
  (let w (substr s 0 5))
  (set s "changed")
  (assert (== w "hello"))
  (assert (== s "changed")))

(test "a view does not see appends or mut calls"
  (var s "abc")
  (let w (substr s 0 2))
  (set s (str s "def"))
  (bang (mut s))
  (assert (== w "ab"))
  (assert (== s "abcdef!")))

(test "a view does not break when its source moves"
  (var v (Vec Str) (vec))
  (var s "hello")
  (let w (substr s 0 2))
  (push (mut v) s)
  (assert (== w "he"))
  (assert (== (at v 0) "hello")))

(test "views of views"
  (let s "programming")
  (let a (substr s 0 7))
  (let b (substr a 3 7))
  (assert (== b "gram"))
  (assert (== (len a) 7)))

(test "field views follow the record"
  (var r (new Named (name "first") (n 1)))
  (let n (. r name))
  (set (. r name) "second")
  (assert (== n "first"))
  (assert (== (. r name) "second")))

(test "view-returning functions"
  (assert (== (first-word "hello big world") "hello"))
  (assert (== (first-word "single") "single"))
  (assert (== (early "") "empty"))
  (assert (== (early "  x  ") "x"))
  (assert (== (first-word (early "  two words ")) "two"))
  (let w (first-word "keep this"))
  (var v (Vec Str) (vec))
  (push (mut v) w)
  (push (mut v) w)
  (assert (== (join v "+") "keep+keep")))

(test "lower and upper copy only when needed"
  (assert (== (norm "  HeLLo ") "hello"))
  (assert (== (norm "abc") "abc"))
  (assert (== (norm "ÁRBOL") "árbol"))
  (let s "MiXeD")
  (let l (lower s))
  (let u (upper s))
  (var v (Vec Str) (vec))
  (push (mut v) l)
  (push (mut v) u)
  (assert (== (join v ",") "mixed,MIXED")))

(test "Str params compare, match and copy"
  (assert (less "abc" "abd"))
  (assert (not (less "b" "a")))
  (assert (== (kind "a") 1))
  (assert (== (kind (substr "xbbx" 1 3)) 2))
  (assert (== (kind "zz") 3))
  (assert (== (pick "x" "y" false) "y"))
  (assert (== (same "id") "id"))
  (assert (== (. (wrap "four") n) 4))
  (assert (== (checked-head "zed" true) "z")))

(test "Vec contains and index-of with views"
  (let words (vec "alpha" "beta" "gamma"))
  (let s "xbetax")
  (assert (contains words (substr s 1 5)))
  (assert (== (unwrap-or (index-of words (substr s 1 5)) -1) 1))
  (assert (not (contains words "delta"))))

(test "views inside split loops"
  (var firsts (Vec Str) (vec))
  (for tok (split "apple,Banana,,cherry" ",")
    (let w (lower tok))
    (if (not (is-empty w)) (push (mut firsts) (substr w 0 1))))
  (assert (== (join firsts "") "abc"))
  (var parts (Vec Str) (vec))
  (for p (split "a::b::c" "::") (push (mut parts) p))
  (assert (== (len parts) 3))
  (var chars (Vec Str) (vec))
  (for c (split "xyz" "") (push (mut chars) c))
  (assert (== (join chars "-") "x-y-z")))

(test "match with pattern bindings is still correct"
  (var m (Map I64 Str) (map))
  (put (mut m) 1 "one")
  (let w (match (get m 1) (case (some s) s) (case none "")))
  (put (mut m) 1 "uno")
  (assert (== w "one")))

(test "map updates look the key up once"
  (var counts (Map Str I64) (map))
  (for tok (split "a b a c a b" " ")
    (put (mut counts) tok (+ 1 (unwrap-or (get counts tok) 0))))
  (assert (== (unwrap-or (get counts "a") 0) 3))
  (assert (== (unwrap-or (get counts "b") 0) 2))
  (assert (== (len counts) 3))
  (var lists (Map I64 (Vec I64)) (map))
  (for i (range 0 6)
    (let k (% i 2))
    (put (mut lists) k (concat (unwrap-or (get lists k) (vec)) (vec i))))
  (assert (== (unwrap-or (get lists 1) (vec)) (vec 1 3 5)))
  (var seen (Map Str Bool) (map))
  (let key "k")
  (put (mut seen) key (is-none (get seen key)))
  (put (mut seen) key (is-none (get seen key)))
  (assert (== (get seen "k") (some false))))

(test "appending in place keeps every part"
  (var s "")
  (set s (str s 1 " " -2 " " 2.5 " " true " " (substr "xyz" 1 2)))
  (let big (- 0 9223372036854775807))
  (set s (str s " " (- big 1)))
  (assert (== s "1 -2 2.5 true y -9223372036854775808"))
  (let n I32 7)
  (assert (== (str "n=" n ", m=" 0) "n=7, m=0")))

(test "explicit overflow handling"
  (let big 9223372036854775807)
  (assert (== (checked-add big 1) none))
  (assert (== (checked-add 1 2) (some 3)))
  (assert (== (checked-mul big 2) none))
  (assert (== (wrapping-add big 1) (- (- 0 big) 1)))
  (let h U64 14695981039346656037)
  (let p U64 1099511628211)
  (assert (== (wrapping-mul (bit-xor h (as U64 97)) p) 12638187200555641996)))

(fn count-words (params (ws (Vec Str))) (returns I64) (body (len ws)))

(fn read-text (params (t Str)) (returns Str) (body (str t "\nlast")))

(test "a Vec of pieces read only by at and len behaves like copies"
  (let text "a b\r\nccc  d\n\nx")
  (let ls (lines text))
  (assert (== (len ls) 4))
  (assert (== (at ls 0) "a b"))
  (assert (is-empty (at ls 2)))
  (let parts (split (at ls 1) " "))
  (assert (== (len parts) 3))
  (assert (== (at parts 1) ""))
  (let first (at parts 0))
  (var dup (at parts 2))
  (set dup (str dup "!"))
  (assert (== dup "d!"))
  (assert (== (at parts 2) "d"))
  (var held (Vec Str) (vec))
  (push (mut held) (at parts 0))
  (assert (== (at held 0) first))
  (assert (== (parse-i64 (trim (at (split " 12,x" ",") 0))) (some 12)))
  (assert (== (count-words (split "p q r" " ")) 3)))

(test "pieces of a string made in place, and of one that changes later"
  (let ls (lines (read-text "one\ntwo")))
  (assert (== (at ls 2) "last"))
  (var s "k=v;w")
  (let kv (split s ";"))
  (set s "gone")
  (assert (== (at kv 0) "k=v"))
  (assert (== (at kv 1) "w"))
  (let e (split "" ","))
  (assert (== (len e) 1))
  (let tail (split "a,b," ","))
  (assert (== (at tail 2) ""))
  (let multi (split "a--b--" "--"))
  (assert (== (len multi) 3))
  (let uni (split "añb ü" " "))
  (assert (== (at uni 1) "ü"))
  (var total 0)
  (for w (split "1 22 333" " ") (set total (+ total (len w))))
  (assert (== total 6)))

(test "a Vec of pieces read in a loop whose bounds checks are hoisted"
  (let ls (lines "3\n1 2\n3 4\n5 6"))
  (var t 0)
  (for i (range 0 3)
    (let parts (split (at ls (+ i 1)) " "))
    (set t (+ t (unwrap-or (parse-i64 (at parts 1)) 0)))
    (set t (+ t (len (at ls (+ i 1))))))
  (assert (== t 21)))

(fn field-ok (params (f (Vec Str))) (returns Bool)
  (body
    (if (!= (len f) 3) (return false))
    (for x f (if (is-empty x) (return false)))
    (let m (at f 1))
    (and (== m "GET") (> (len (at f 2)) 0))))

(fn total-len (params (f (Vec Str))) (returns I64)
  (body
    (var n 0)
    (for i (range 0 (len f)) (set n (+ n (len (at f i)))))
    n))

(fn first-two (params (f (Vec Str))) (returns Str) (body (str (at f 0) (at f 1))))

(fn keep (params (f (Vec Str))) (returns (Vec Str)) (body f))

(test "split vectors read by element see the string as it was"
  (var s "a bb ccc")
  (let f (split s " "))
  (let x (at f 1))
  (set s "changed")
  (assert (== (len f) 3))
  (assert (== x "bb"))
  (assert (== (at f 2) "ccc"))
  (let g (split "1 GET /p" " "))
  (assert (field-ok g))
  (assert (not (field-ok (split "1 PUT /p" " "))))
  (assert (field-ok (vec "z" "GET" "q")))
  (assert (== (total-len g) 6))
  (assert (== (total-len (vec "ab" "c")) 3))
  (assert (== (first-two g) "1GET"))
  (assert (== (keep (split "p,q" ",")) (vec "p" "q"))))

(test "lines of a temporary and elements in loops"
  (let ls (lines (str "one\ntwo\r\n" "three")))
  (assert (== (len ls) 3))
  (assert (== (at ls 1) "two"))
  (var n 0)
  (for l ls (set n (+ n (len l))))
  (assert (== n 11))
  (var cs (Vec Str) (vec))
  (let ch (split "héllo" ""))
  (for c ch (push (mut cs) c))
  (assert (== (join cs "|") "h|é|l|l|o")))

(test "an element view does not see the vector change"
  (var v (vec "a" "b"))
  (let x (at v 0))
  (set (at v 0) "z")
  (push (mut v) "c")
  (assert (== x "a"))
  (assert (== (join v "") "zbc")))

(test "many pieces summed in a parallel loop"
  (let big (join (fill 20000 "ab") " "))
  (let ws (split big " "))
  (var total 0)
  (for w ws (set total (+ total (len w))))
  (assert (== total 40000))
  (var out (Vec Str) (vec))
  (for w ws (push (mut out) w))
  (assert (== (len out) 20000))
  (assert (== (at out 19999) "ab")))

(fn norm-path (params (p Str)) (returns Str)
  (body
    (var parts (Vec Str) (vec))
    (for piece (split p "/")
      (if (and (> (len piece) 0) (== (byte-at piece 0) 49))
        (push (mut parts) "{id}")
        (push (mut parts) piece)))
    (join parts "/")))

(test "vectors filled with pieces join them"
  (assert (== (norm-path "/api/1x/b//1") "/api/{id}/b//{id}"))
  (var src "k1,k2")
  (var got (Vec Str) (vec))
  (for t (split src ",") (push (mut got) t))
  (set src "gone")
  (assert (== (join got ";") "k1;k2"))
  (var owned (Vec Str) (vec))
  (for t (split "u,v" ",")
    (let u (str t "!"))
    (push (mut owned) u))
  (assert (== (join owned "") "u!v!"))
  (var mixed (Vec Str) (vec))
  (var base "abc")
  (push (mut mixed) (substr base 0 1))
  (set base "xyz")
  (push (mut mixed) base)
  (assert (== (join mixed "") "axyz")))

(test "a let then put looks the key up once"
  (var counts (Map Str I64) (map))
  (var aggs (Map Str Named) (map))
  (for tok (split "a b a c a" " ")
    (let r (new Named (name tok) (n 1)))
    (let c (unwrap-or (get counts (. r name)) 0))
    (put (mut counts) (. r name) (+ c 1))
    (let a (unwrap-or (get aggs tok) (new Named (name tok) (n 0))))
    (put (mut aggs) tok (new Named (name (. a name)) (n (+ (. a n) 2)))))
  (assert (== (get counts "a") (some 3)))
  (assert (== (get counts "c") (some 1)))
  (assert (== (. (expect (get aggs "a") "a") n) 6))
  (var m (Map I64 I64) (map))
  (let k 4)
  (let old (unwrap-or (get m k) 10))
  (put (mut m) k (* old 2))
  (assert (== (get m 4) (some 20)))
  (let again (unwrap-or (get m k) 0))
  (put (mut m) k (+ again 1))
  (assert (== again 20))
  (assert (== (get m 4) (some 21))))
