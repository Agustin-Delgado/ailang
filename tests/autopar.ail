; Tests for loops the compiler runs in parallel on its own: every result must be the one the
; sequential loop gives. Each expected value is computed with a `while` loop, which stays
; sequential. Run with: ail test tests/autopar.ail

(fn work (params (x I64)) (returns I64)
  (body
    (var v x)
    (var steps 0)
    (while (> v 1)
      (set v (if (== (% v 2) 0) (/ v 2) (+ (* 3 v) 1)))
      (set steps (+ steps 1)))
    steps))

(test "sums and counts"
  (var total 0)
  (var odd 0)
  (for i (range 0 100000)
    (set total (+ total (work i)))
    (if (== (% (work i) 2) 1) (set odd (+ odd 1))))
  (var t2 0)
  (var o2 0)
  (var i 0)
  (while (< i 100000)
    (set t2 (+ t2 (work i)))
    (if (== (% (work i) 2) 1) (set o2 (+ o2 1)))
    (set i (+ i 1)))
  (assert (== total t2))
  (assert (== odd o2)))

(test "a sum that starts from a value and subtracts"
  (var acc 1000)
  (for i (range 0 50000) (set acc (- acc (work i))))
  (var a2 1000)
  (var i 0)
  (while (< i 50000)
    (set a2 (- a2 (work i)))
    (set i (+ i 1)))
  (assert (== acc a2)))

(test "a histogram"
  (var h (Vec I64) (fill 200 0))
  (for i (range 0 100000)
    (let k (% (work i) 200))
    (set (at h k) (+ (at h k) 1)))
  (var h2 (Vec I64) (fill 200 0))
  (var i 0)
  (while (< i 100000)
    (let k (% (work i) 200))
    (set (at h2 k) (+ (at h2 k) 1))
    (set i (+ i 1)))
  (assert (== h h2)))

(test "running maximum keeps the first of ties, >= keeps the last"
  (var best -1)
  (var at-first -1)
  (for i (range 0 100000)
    (if (> (work i) best)
      (do
        (set best (work i))
        (set at-first i))))
  (var best2 -1)
  (var at-last -1)
  (for i (range 0 100000)
    (if (>= (work i) best2)
      (do
        (set best2 (work i))
        (set at-last i))))
  (var b -1)
  (var f -1)
  (var l -1)
  (var i 0)
  (while (< i 100000)
    (let w (work i))
    (if (> w b) (set f i))
    (if (>= w b) (set l i))
    (if (> w b) (set b w))
    (set i (+ i 1)))
  (assert (== best b))
  (assert (== best2 b))
  (assert (== at-first f))
  (assert (== at-last l))
  (var low 1000000)
  (for i (range 1 100000)
    (if (< (work i) low) (set low (work i))))
  (assert (== low 0)))

(test "writes to disjoint elements, flat and by rows"
  (let n 300)
  (var flat (Vec I64) (fill (* n n) 0))
  (for r (range 0 n)
    (let base (* r n))
    (for c (range 0 n)
      (set (at flat (+ base c)) (+ (work r) c))))
  (var grid (Vec (Vec I64)) (fill n (fill n 0)))
  (for r (range 0 n)
    (for c (range 0 n)
      (set (at (at grid r) c) (* (work c) r))))
  (var ok true)
  (var r 0)
  (while (< r n)
    (var c 0)
    (while (< c n)
      (if (!= (at flat (+ (* r n) c)) (+ (work r) c)) (set ok false))
      (if (!= (at (at grid r) c) (* (work c) r)) (set ok false))
      (set c (+ c 1)))
    (set r (+ r 1)))
  (assert ok))

(test "pushes keep iteration order"
  (var out (Vec Str) (vec))
  (var evens (Vec I64) (vec))
  (for i (range 0 60000)
    (push (mut out) (str i ":" (work i)))
    (if (== (% i 2) 0) (push (mut evens) i)))
  (assert (== (len out) 60000))
  (assert (== (at out 0) "0:0"))
  (assert (== (at out 27) (str "27:" (work 27))))
  (assert (== (at out 59999) (str "59999:" (work 59999))))
  (assert (== (len evens) 30000))
  (var sorted true)
  (var i 1)
  (while (< i (len evens))
    (if (<= (at evens i) (at evens (- i 1))) (set sorted false))
    (set i (+ i 1)))
  (assert sorted))

(test "an overlapping write stays sequential and correct"
  ; Each iteration writes two elements and the next one overwrites one: last write wins.
  (var v (Vec I64) (fill 20001 0))
  (for i (range 0 10000)
    (set (at v (* 2 i)) (work i))
    (set (at v (+ (* 2 i) 2)) (- 0 i)))
  (var ok true)
  (var k 1)
  (while (< k 10000)
    (if (!= (at v (* 2 k)) (work k)) (set ok false))
    (set k (+ k 1)))
  (assert ok)
  (assert (== (at v 20000) (- 0 9999))))

(test "a sum modulo m, and the last value assigned"

  (var s 7)
  (var first -1)
  (var last -1)
  (for i (range 0 80000)
    (let w (work i))
    (set s (% (+ s (* w 1000003)) 1000000007))
    (if (== i 0) (set first w))
    (if (== (% i 7) 3) (set last (+ w i))))
  (var s2 7)
  (var l2 -1)
  (var i 0)
  (while (< i 80000)
    (let w (work i))
    (set s2 (% (+ s2 (* w 1000003)) 1000000007))
    (if (== (% i 7) 3) (set l2 (+ w i)))
    (set i (+ i 1)))
  (assert (== s s2))
  (assert (== first 0))
  (assert (== last l2)))

(test "loops over the elements of a vector and the lines of a string"
  (var xs (Vec I64) (vec))
  (var text "")
  (for i (range 0 30000)
    (push (mut xs) (* i 3))
    (set text (str text i "\n")))
  (var total 0)
  (var big (Vec I64) (vec))
  (for x xs
    (set total (+ total (work x)))
    (if (> (work x) 100) (push (mut big) x)))
  (var count 0)
  (var lens 0)
  (for line (lines text)
    (set count (+ count 1))
    (set lens (+ lens (work (expect (parse-i64 line) "number")))))
  (var t2 0)
  (var b2 (Vec I64) (vec))
  (var l2 0)
  (var i 0)
  (while (< i 30000)
    (let x (* i 3))
    (set t2 (+ t2 (work x)))
    (if (> (work x) 100) (push (mut b2) x))
    (set l2 (+ l2 (work i)))
    (set i (+ i 1)))
  (assert (== total t2))
  (assert (== big b2))
  (assert (== count 30000))
  (assert (== lens l2)))

(test "a scratch vector overwritten at the start of every iteration"
  (let n 120)
  (var row (Vec I64) (fill n 0))
  (var tmp (Vec I64) (vec))
  (var acc 0)
  (for i (range 0 n)
    (for j (range 0 n) (set (at row j) 0))
    (set tmp (vec i))
    (for k (range 0 n)
      (for j (range 0 n)
        (set (at row j) (+ (at row j) (* (work k) (+ i j))))))
    (push (mut tmp) (work i))
    (for j (range 0 n)
      (set acc (% (+ acc (at row j) (at tmp 1)) 1000000007))))
  (var row2 (Vec I64) (fill n 0))
  (var acc2 0)
  (var i 0)
  (while (< i n)
    (var j 0)
    (while (< j n) (set (at row2 j) 0) (set j (+ j 1)))
    (var k 0)
    (while (< k n)
      (set j 0)
      (while (< j n)
        (set (at row2 j) (+ (at row2 j) (* (work k) (+ i j))))
        (set j (+ j 1)))
      (set k (+ k 1)))
    (set j 0)
    (while (< j n)
      (set acc2 (% (+ acc2 (at row2 j) (work i)) 1000000007))
      (set j (+ j 1)))
    (set i (+ i 1)))
  (assert (== acc acc2))
  (assert (== row row2))
  (assert (== tmp (vec (- n 1) (work (- n 1))))))

(test "rows that read their own elements while writing them (floyd)"
  (let n 300)
  (var d (Vec I64) (fill (* n n) 0))
  (for i (range 0 (* n n)) (set (at d i) (+ 1 (% (work i) 97))))
  (var d2 (copy d))
  (for k (range 0 n)
    (let rowk (slice d (* k n) (* (+ k 1) n)))
    (for i (range 0 n)
      (let dik (at d (+ (* i n) k)))
      (for j (range 0 n)
        (let c (+ dik (at rowk j)))
        (if (< c (at d (+ (* i n) j)))
          (set (at d (+ (* i n) j)) c)))))
  (var k 0)
  (while (< k n)
    (var i 0)
    (while (< i n)
      (var j 0)
      (while (< j n)
        (let c (+ (at d2 (+ (* i n) k)) (at d2 (+ (* k n) j))))
        (if (< c (at d2 (+ (* i n) j)))
          (set (at d2 (+ (* i n) j)) c))
        (set j (+ j 1)))
      (set i (+ i 1)))
    (set k (+ k 1)))
  (assert (== d d2)))

(test "a read outside the iteration's own row keeps the loop sequential"
  (let n 200)
  (var g (Vec I64) (fill (* n n) 1))
  (for i (range 1 n)
    (for j (range 0 n)
      (set (at g (+ (* i n) j)) (+ (at g (+ (* (- i 1) n) j)) (work j)))))
  (var g2 (Vec I64) (fill (* n n) 1))
  (var i 1)
  (while (< i n)
    (var j 0)
    (while (< j n)
      (set (at g2 (+ (* i n) j)) (+ (at g2 (+ (* (- i 1) n) j)) (work j)))
      (set j (+ j 1)))
    (set i (+ i 1)))
  (assert (== g g2)))

(test "0/1 knapsack over one row walked backwards reads the row as it was"
  (let cap 200000)
  (var dp (Vec I64) (fill (+ cap 1) 0))
  (var d2 (Vec I64) (fill (+ cap 1) 0))
  (for item (range 0 6)
    (let w (+ 3 (* item 7)))
    (let v (+ 10 (* item item)))
    (for j (range 0 (+ (- cap w) 1))
      (let c (- cap j))
      (set (at dp c) (max (at dp c) (+ (at dp (- c w)) v))))
    (var c cap)
    (while (>= c w)
      (set (at d2 c) (max (at d2 c) (+ (at d2 (- c w)) v)))
      (set c (- c 1))))
  (assert (== dp d2)))

(test "a row walked forwards that reads ahead sees old values"
  (let n 300000)
  (var a (Vec I64) (fill n 0))
  (for i (range 0 n) (set (at a i) (% (* i 37) 101)))
  (var b (copy a))
  (let k 5)
  (for i (range 0 (- n k))
    (set (at a i) (+ (at a i) (at a (+ i k)))))
  (var i 0)
  (while (< i (- n k))
    (set (at b i) (+ (at b i) (at b (+ i k))))
    (set i (+ i 1)))
  (assert (== a b)))

(test "a read behind the write front stays sequential"
  (let n 300000)
  (var a (Vec I64) (fill n 1))
  (var b (Vec I64) (fill n 1))
  (let k 3)
  (for i (range k n)
    (set (at a i) (% (+ (at a i) (at a (- i k))) 1000003)))
  (var i k)
  (while (< i n)
    (set (at b i) (% (+ (at b i) (at b (- i k))) 1000003))
    (set i (+ i 1)))
  (assert (== a b)))
