; Tests for par-map and par-run: same results, same order as map, whatever the timing.
; Run with: ail test tests/concurrency.ail

(fn collatz (params (n I64)) (returns I64)
  (body
    (var x n)
    (var steps 0)
    (while (!= x 1)
      (set x (if (== (% x 2) 0) (/ x 2) (+ (* 3 x) 1)))
      (set steps (+ steps 1)))
    steps))

(test "par-map equals map, in order"
  (var xs (Vec I64) (vec))
  (for i (range 1 5000) (push (mut xs) i))
  (assert (== (par-map xs (lambda (x) (collatz x))) (map xs (lambda (x) (collatz x))))))

(test "par-run equals map, in order"
  (var xs (Vec I64) (vec))
  (for i (range 0 300) (push (mut xs) i))
  (let k 7)
  (assert (== (par-run xs (lambda (x) (str x "-" (* x k)))) (map xs (lambda (x) (str x "-" (* x k))))))
  (assert (== (len (par-run (vec 1) (lambda (x) x))) 1))
  (let empty (Vec I64) (vec))
  (assert (is-empty (par-run empty (lambda (x) x)))))


(test "a pipeline keeps the order of every channel"
  (var got (Vec I64) (vec))
  (var evens 0)
  (tasks
    (channel nums I64)
    (channel squares I64)
    (task (out nums)
      (for i (range 0 20000) (send nums i)))
    (task (in nums) (out squares) (mut evens)
      (for n nums
        (if (== (% n 2) 0) (set evens (+ evens 1)))
        (send squares (* n n))))
    (task (in squares) (mut got)
      (for s squares (push (mut got) s))))
  (assert (== evens 10000))
  (assert (== (len got) 20000))
  (var ok true)
  (for i (range 0 20000) (if (!= (at got i) (* i i)) (set ok false)))
  (assert ok))

(test "recv returns none once the sender has finished"
  (var seen (Vec Str) (vec))
  (tasks
    (channel words Str)
    (task (out words) (for w (split "a b c" " ") (send words w)))
    (task (in words) (mut seen)
      (while true
        (match (recv words)
          (case (some w) (push (mut seen) (upper w)))
          (case none break)))))
  (assert (== (join seen "") "ABC")))

(test "independent tasks each fill their own variable"
  (var a 0)
  (var b "")
  (let base 10)
  (tasks
    (task (mut a) (for i (range 0 1000) (set a (+ a base))))
    (task (mut b) (for i (range 0 3) (set b (str b base)))))
  (assert (== a 10000))
  (assert (== b "101010")))

(test "structs and vectors travel over channels"
  (var total 0)
  (tasks
    (channel batches (Vec I64))
    (task (out batches)
      (for i (range 0 100) (send batches (vec i (+ i 1) (+ i 2)))))
    (task (in batches) (mut total)
      (for v batches (set total (+ total (sum v))))))
  (assert (== total 15150)))
