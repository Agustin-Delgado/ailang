; Tests for loops that call fns on narrow copies of their vectors (dense regions: a filter
; applied many times to an image). Each result is compared with the same work written so that
; it cannot run that way: the reference loop also pushes to a log vector from outside, which a
; dense region cannot hold.
; Run with: ail test tests/dense.ail

(fn lcg (params (x I64)) (returns I64)
  (body (% (+ (* x 1103515245) 12345) 2147483648)))

(fn image (params (n I64) (seed I64) (lo I64) (span I64)) (returns (Vec I64))
  (body
    (var v (Vec I64) (fill n 0))
    (var x seed)
    (for i (range 0 n)
      (set x (lcg x))
      (set (at v i) (+ lo (% (/ x 7) span))))
    v))

(fn med3 (params (a I64) (b I64) (c I64)) (returns I64)
  (body (max (min a b) (min (max a b) c))))

; One 3x3 median pass with clamped edges, as models write it.
(fn pass (params (src (Vec I64)) (dst (mut (Vec I64))) (w I64) (h I64)) (returns I64)
  (body
    (var changed 0)
    (for r (range 0 h)
      (let up (if (> r 0) (- r 1) 0))
      (let dn (if (< r (- h 1)) (+ r 1) (- h 1)))
      (var lo (fill w 0))
      (var mi (fill w 0))
      (var hi (fill w 0))
      (for c (range 0 w)
        (let x (at src (+ (* up w) c)))
        (let y (at src (+ (* r w) c)))
        (let z (at src (+ (* dn w) c)))
        (set (at lo c) (min x (min y z)))
        (set (at mi c) (med3 x y z))
        (set (at hi c) (max x (max y z))))
      (for c (range 0 w)
        (let cl (if (> c 0) (- c 1) 0))
        (let cr (if (< c (- w 1)) (+ c 1) (- w 1)))
        (let a (max (at lo cl) (max (at lo c) (at lo cr))))
        (let b (med3 (at mi cl) (at mi c) (at mi cr)))
        (let d (min (at hi cl) (min (at hi c) (at hi cr))))
        (let v (med3 a b d))
        (if (!= v (at src (+ (* r w) c))) (set changed (+ changed 1)))
        (set (at dst (+ (* r w) c)) v)))
    changed))

(fn run-filter (params (img (Vec I64)) (w I64) (h I64) (t I64)) (returns (Vec I64))
  (body
    (var a (copy img))
    (var b (fill (len img) 0))
    (var k 0)
    (var total 0)
    (while (< k t)
      (var d 0)
      (if (== (% k 2) 0) (set d (pass a (mut b) w h)) (set d (pass b (mut a) w h)))
      (set total (+ total d))
      (set k (+ k 1)))
    (var out (if (== (% k 2) 0) a b))
    (push (mut out) total)
    out))

(fn filter-ref (params (img (Vec I64)) (w I64) (h I64) (t I64)) (returns (Vec I64))
  (body
    (var a (copy img))
    (var b (fill (len img) 0))
    (var log (Vec I64) (vec))
    (var k 0)
    (var total 0)
    (while (< k t)
      (var d 0)
      (if (== (% k 2) 0) (set d (pass a (mut b) w h)) (set d (pass b (mut a) w h)))
      (push (mut log) d)
      (set total (+ total d))
      (set k (+ k 1)))
    (var out (if (== (% k 2) 0) a b))
    (push (mut out) total)
    out))

(test "a median filter on u8 copies gives the plain result"
  (let img (image 40000 3 0 256))
  (assert (== (run-filter img 200 200 5) (filter-ref img 200 200 5))))

(test "values that need i16 or i32 copies"
  (let a (image 40000 5 -1000 2000))
  (assert (== (run-filter a 250 160 4) (filter-ref a 250 160 4)))
  (let b (image 40000 9 -100000000 200000000))
  (assert (== (run-filter b 160 250 3) (filter-ref b 160 250 3))))

(test "values that fit in no narrow type run as written"
  (var c (image 40000 13 0 256))
  (set (at c 777) 9000000000)
  (assert (== (run-filter c 200 200 3) (filter-ref c 200 200 3))))

; (The fns below walk with `while`: a `for` would become a GPU kernel, and a fn with kernels
; keeps device copies of its vectors instead.)
; Each step adds k to every pixel: the values outgrow u8 half way, the run is thrown away and
; the loop runs again from the start (the count and the step start again too).
(fn brighten (params (src (Vec I64)) (dst (mut (Vec I64))) (k I64)) (returns I64)
  (body
    (var big 0)
    (var i 0)
    (while (< i (len src))
      (let v (+ (at src i) k))
      (if (> v 200) (set big (+ big 1)))
      (set (at dst i) v)
      (set i (+ i 1)))
    big))

(fn brighten-all (params (img (Vec I64)) (logged Bool)) (returns (Vec I64))
  (body
    (var a (copy img))
    (var b (fill (len img) 0))
    (var bigs 0)
    (var k 0)
    (while (< k 8)
      (if (== (% k 2) 0) (set bigs (+ bigs (brighten a (mut b) 30))) (set bigs (+ bigs (brighten b (mut a) 30))))
      (set k (+ k 1)))
    (push (mut a) bigs)
    (push (mut a) k)
    (concat a b)))

(fn brighten-all-ref (params (img (Vec I64)) (logged Bool)) (returns (Vec I64))
  (body
    (var a (copy img))
    (var b (fill (len img) 0))
    (var log (Vec I64) (vec))
    (var bigs 0)
    (var k 0)
    (while (< k 8)
      (if (== (% k 2) 0) (set bigs (+ bigs (brighten a (mut b) 30))) (set bigs (+ bigs (brighten b (mut a) 30))))
      (push (mut log) k)
      (set k (+ k 1)))
    (push (mut a) bigs)
    (push (mut a) k)
    (concat a b)))

(test "a store that stops fitting half way gives the plain result"
  (let img (image 50000 21 0 100))
  (assert (== (brighten-all img false) (brighten-all-ref img true))))

; A scratch vector made with a value that does not fit throws the run away.
(fn spread (params (src (Vec I64)) (dst (mut (Vec I64))) (fillv I64)) (returns I64)
  (body
    (var tmp (fill (len src) fillv))
    (var i 0)
    (while (< i (len src))
      (set (at dst i) (max (at src i) (at tmp i)))
      (set i (+ i 1)))
    (at tmp 0)))

(fn spread-all (params (img (Vec I64)) (logged Bool)) (returns (Vec I64))
  (body
    (var a (copy img))
    (var b (fill (len img) 0))
    (var s 0)
    (for k (range 0 4)
      (set s (+ s (spread a (mut b) (* k 100))))
      (set s (+ s (spread b (mut a) 1))))
    (push (mut a) s)
    a))

(fn spread-all-ref (params (img (Vec I64)) (logged Bool)) (returns (Vec I64))
  (body
    (var a (copy img))
    (var b (fill (len img) 0))
    (var log (Vec I64) (vec))
    (var s 0)
    (for k (range 0 4)
      (set s (+ s (spread a (mut b) (* k 100))))
      (set s (+ s (spread b (mut a) 1)))
      (push (mut log) k))
    (push (mut a) s)
    a))

(test "a scratch vector filled out of range gives the plain result"
  (let img (image 40000 2 0 256))
  (assert (== (spread-all img false) (spread-all-ref img true))))
