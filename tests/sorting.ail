; Tests for sort, which runs on all cores for long vectors: the result must be sorted and hold
; the same elements. Run with: ail test tests/sorting.ail

(struct Item (key I64) (tag I64))

(fn gen (params (n I64) (modulo I64)) (returns (Vec I64))
  (body
    (var x U64 12345)
    (var out (Vec I64) (vec))
    (for i (range 0 n)
      (set x (wrapping-add (wrapping-mul x 6364136223846793005) 1442695040888963407))
      (push (mut out) (- (% (as I64 (shr x 33)) modulo) (/ modulo 2))))
    out))

(fn fingerprint (params (v (Vec I64))) (returns I64)
  (body
    (var s 0)
    (var x 0)
    (for e v
      (set s (+ s e))
      (set x (bit-xor x (* e 2654435761))))
    (+ s x)))

(test "a long vector of integers with many ties"
  (let v (gen 300000 1000))
  (var w (copy v))
  (sort (mut w))
  (var ok true)
  (var i 1)
  (while (< i (len w))
    (if (> (at w (- i 1)) (at w i)) (set ok false))
    (set i (+ i 1)))
  (assert ok)
  (assert (== (fingerprint v) (fingerprint w))))

(test "descending, floats, strings and structs"
  (let v (gen 200000 50000))
  (var d (copy v))
  (sort-desc (mut d))
  (var ok true)
  (var i 1)
  (while (< i (len d))
    (if (< (at d (- i 1)) (at d i)) (set ok false))
    (set i (+ i 1)))
  (assert ok)
  (assert (== (fingerprint v) (fingerprint d)))
  (var fs (Vec F64) (vec))
  (for e v (push (mut fs) (/ (as F64 e) 7.0)))
  (sort (mut fs))
  (set i 1)
  (while (< i (len fs))
    (if (> (at fs (- i 1)) (at fs i)) (set ok false))
    (set i (+ i 1)))
  (assert ok)
  (var ss (Vec Str) (vec))
  (for e (slice v 0 100000) (push (mut ss) (str "k" e)))
  (sort (mut ss))
  (set i 1)
  (while (< i (len ss))
    (if (> (at ss (- i 1)) (at ss i)) (set ok false))
    (set i (+ i 1)))
  (assert ok)
  (var items (Vec Item) (vec))
  (for e v (push (mut items) (new Item (key (% e 100)) (tag e))))
  (sort (mut items))
  (set i 1)
  (while (< i (len items))
    (let a (at items (- i 1)))
    (let b (at items i))
    (if (or (> (. a key) (. b key)) (and (== (. a key) (. b key)) (> (. a tag) (. b tag)))) (set ok false))
    (set i (+ i 1)))
  (assert ok)
  (var tags (Vec I64) (vec))
  (for it items (push (mut tags) (. it tag)))
  (assert (== (fingerprint v) (fingerprint tags))))
