; A trap in one branch of an if computed in the narrow type of a dense region (a fn run on u8
; copies of its vectors) is placed at that branch, as in the plain run.

(fn step (params (src (Vec I64)) (dst (mut (Vec I64))) (bad I64)) (returns I64)
  (body
    (var i 0)
    (let n (len src))
    (var s 0)
    (while (< i n)
      (let x (if (== i bad)
               (at src n) ; traps here
               (at src i)))
      (set s (+ s x))
      (set (at dst i) (+ x 1))
      (set i (+ i 1)))
    s))

(fn main (params (con Console))
  (body
    (var a (fill 40000 100))
    (var b (fill 40000 0))
    (var t 0)
    (var tot 0)
    (while (< t 4)
      (println con "pass " t " total " tot)
      (let bad (if (== t 2) 777 -1))
      (if (== (% t 2) 0) (set tot (+ tot (step a (mut b) bad))) (set tot (+ tot (step b (mut a) bad))))
      (set t (+ t 1)))
    (println con "done " tot)))
