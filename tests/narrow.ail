; Tests for loops that run on 32-bit copies of their vectors (graph walks: indices read from
; other vectors). Each result is compared with the same walk written so that it cannot run that
; way: it reads through `get-at`, and a vector passed to a fn keeps its 64-bit elements.
; Run with: ail test tests/narrow.ail

(fn lcg (params (x I64)) (returns I64)
  (body (% (+ (* x 1103515245) 12345) 2147483648)))

(fn get-at (params (v (Vec I64)) (i I64)) (returns I64)
  (body (at v i)))

; Edge lists of a random graph: (us vs).
(fn edges (params (n I64) (m I64) (seed I64) (which I64)) (returns (Vec I64))
  (body
    (var out (Vec I64) (fill m 0))
    (var x seed)
    (for i (range 0 m)
      (set x (lcg x))
      (let u (% x n))
      (set x (lcg x))
      (let v (% x n))
      (set (at out i) (if (== which 0) u v)))
    out))

(fn offsets (params (n I64) (us (Vec I64)) (vs (Vec I64))) (returns (Vec I64))
  (body
    (var off (Vec I64) (fill (+ n 1) 0))
    (var i 0)
    (while (< i (len us))
      (set (at off (+ (at us i) 1)) (+ (at off (+ (at us i) 1)) 1))
      (set (at off (+ (at vs i) 1)) (+ (at off (+ (at vs i) 1)) 1))
      (set i (+ i 1)))
    (set i 0)
    (while (< i n)
      (set (at off (+ i 1)) (+ (at off (+ i 1)) (at off i)))
      (set i (+ i 1)))
    off))

(fn adjacency (params (n I64) (us (Vec I64)) (vs (Vec I64)) (off (Vec I64))) (returns (Vec I64))
  (body
    (var pos (Vec I64) (fill n 0))
    (var i 0)
    (while (< i n)
      (set (at pos i) (at off i))
      (set i (+ i 1)))
    (var adj (Vec I64) (fill (* 2 (len us)) 0))
    (set i 0)
    (while (< i (len us))
      (let u (at us i))
      (let v (at vs i))
      (set (at adj (at pos u)) v)
      (set (at pos u) (+ (at pos u) 1))
      (set (at adj (at pos v)) u)
      (set (at pos v) (+ (at pos v) 1))
      (set i (+ i 1)))
    adj))

; The reference walk: reached count and distance sum for each source, stamps from `base`.
(fn walk-ref (params (n I64) (off (Vec I64)) (adj (Vec I64)) (srcs (Vec I64)) (base I64)) (returns (Vec I64))
  (body
    (var mark (Vec I64) (fill n 0))
    (var dist (Vec I64) (fill n 0))
    (var queue (Vec I64) (fill n 0))
    (var out (Vec I64) (vec))
    (var k 0)
    (while (< k (len srcs))
      (let src (at srcs k))
      (let stamp (+ k base))
      (set (at mark src) stamp)
      (set (at dist src) 0)
      (set (at queue 0) src)
      (var head 0)
      (var tail 1)
      (var total 0)
      (while (< head tail)
        (let x (get-at queue head))
        (set head (+ head 1))
        (let dx (get-at dist x))
        (set total (+ total dx))
        (var e (get-at off x))
        (let end (get-at off (+ x 1)))
        (while (< e end)
          (let y (get-at adj e))
          (if (!= (get-at mark y) stamp)
            (do
              (set (at mark y) stamp)
              (set (at dist y) (+ dx 1))
              (set (at queue tail) y)
              (set tail (+ tail 1))))
          (set e (+ e 1))))
      (push (mut out) tail)
      (push (mut out) total)
      (set k (+ k 1)))
    out))

(fn sources (params (n I64)) (returns (Vec I64))
  (body
    (var s (Vec I64) (vec))
    (for k (range 0 8) (push (mut s) (% (* k 4999) n)))
    s))

; The walk as an agent writes it: everything through `at`, results in vectors from outside.
(fn walk (params (n I64) (off (Vec I64)) (adj (Vec I64)) (srcs (Vec I64)) (base I64)) (returns (Vec I64))
  (body
    (var mark (Vec I64) (fill n 0))
    (var dist (Vec I64) (fill n 0))
    (var queue (Vec I64) (fill n 0))
    (var res (Vec I64) (fill (* 2 (len srcs)) 0))
    (let ns (len srcs))
    (var k 0)
    (while (< k ns)
      (let src (at srcs k))
      (let stamp (+ k base))
      (set (at mark src) stamp)
      (set (at dist src) 0)
      (set (at queue 0) src)
      (var head 0)
      (var tail 1)
      (var total 0)
      (while (< head tail)
        (let x (at queue head))
        (set head (+ head 1))
        (let dx (at dist x))
        (set total (+ total dx))
        (var e (at off x))
        (let end (at off (+ x 1)))
        (while (< e end)
          (let y (at adj e))
          (if (!= (at mark y) stamp)
            (do
              (set (at mark y) stamp)
              (set (at dist y) (+ dx 1))
              (set (at queue tail) y)
              (set tail (+ tail 1))))
          (set e (+ e 1))))
      (set (at res (* 2 k)) tail)
      (set (at res (+ (* 2 k) 1)) total)
      (set k (+ k 1)))
    res))

(test "a graph walk on narrow copies gives the plain result"
  (let n 40000)
  (let us (edges n 100000 7 0))
  (let vs (edges n 100000 7 1))
  (let off (offsets n us vs))
  (let adj (adjacency n us vs off))
  (let srcs (sources n))
  (assert (== (walk n off adj srcs 1) (walk-ref n off adj srcs 1))))

(test "a stamp that does not fit in 32 bits throws the fast run away at once"
  (let n 40000)
  (let us (edges n 100000 11 0))
  (let vs (edges n 100000 11 1))
  (let off (offsets n us vs))
  (let adj (adjacency n us vs off))
  (let srcs (sources n))
  (assert (== (walk n off adj srcs 3000000000) (walk-ref n off adj srcs 3000000000))))

; Scores that outgrow 32 bits after a few sources: the fast run is thrown away half way, and
; the plain variables it changed (grand, k) start again from their values before the loop.
(test "a store that stops fitting half way gives the plain result"
  (let n 40000)
  (let us (edges n 100000 5 0))
  (let vs (edges n 100000 5 1))
  (let off (offsets n us vs))
  (let adj (adjacency n us vs off))
  (let srcs (sources n))
  (var mark (Vec I64) (fill n 0))
  (var queue (Vec I64) (fill n 0))
  (var score (Vec I64) (fill 8 0))
  (var grand 0)
  (var k 0)
  (while (< k 8)
    (let src (at srcs k))
    (set (at mark src) (+ k 1))
    (set (at queue 0) src)
    (var head 0)
    (var tail 1)
    (while (< head tail)
      (let x (at queue head))
      (set head (+ head 1))
      (for e (range (at off x) (at off (+ x 1)))
        (let y (at adj e))
        (if (!= (at mark y) (+ k 1))
          (do
            (set (at mark y) (+ k 1))
            (set (at queue tail) y)
            (set tail (+ tail 1))))))
    (set grand (+ grand tail))
    (set (at score k) (+ tail (* (+ k 1) 600000000)))
    (set k (+ k 1)))
  (let want (walk-ref n off adj srcs 1))
  (var g2 0)
  (for j (range 0 8)
    (set g2 (+ g2 (at want (* 2 j))))
    (assert (== (at score j) (+ (at want (* 2 j)) (* (+ j 1) 600000000)))))
  (assert (== grand g2))
  (assert (== k 8)))

; A vector made inside the loop with `fill`, read in a range loop over offsets.
(test "distances in a vector made per source"
  (let n 40000)
  (let us (edges n 100000 13 0))
  (let vs (edges n 100000 13 1))
  (let off (offsets n us vs))
  (let adj (adjacency n us vs off))
  (let srcs (sources n))
  (var queue (Vec I64) (fill n 0))
  (var got (Vec I64) (fill 16 0))
  (var ki 0)
  (for src srcs
    (var dist (Vec I64) (fill n -1))
    (set (at dist src) 0)
    (set (at queue 0) src)
    (var head 0)
    (var tail 1)
    (var total 0)
    (while (< head tail)
      (let u (at queue head))
      (set head (+ head 1))
      (let nd (+ (at dist u) 1))
      (for e (range (at off u) (at off (+ u 1)))
        (let w (at adj e))
        (if (< (at dist w) 0)
          (do
            (set (at dist w) nd)
            (set (at queue tail) w)
            (set tail (+ tail 1))
            (set total (+ total nd))))))
    (set (at got (* 2 ki)) tail)
    (set (at got (+ (* 2 ki) 1)) total)
    (set ki (+ ki 1)))
  (assert (== got (walk-ref n off adj srcs 1))))
