; No trap: sums and writes the GPU must get exactly right.
(fn main (params (con Console))
  (body
    (let n 400000)
    (var v (Vec I64) (fill n 0))
    (for i (range 0 n) (set (at v i) (- (* (% i 977) (% i 31)) 9000)))
    (var s 0)
    (var t 0)
    (for i (range 0 n)
      (set s (+ s (at v i)))
      (set t (+ t (* (at v i) (at v i)))))
    (var f (Vec F64) (fill n 0.0))
    (for i (range 0 n) (set (at f i) (/ (as F64 (at v i)) 7.0)))
    (var fs 0.0)
    (for i (range 0 n) (set fs (+ fs (at f i))))
    (println con s)
    (println con t)
    (println con fs)
    (println con (at f 12345))))
